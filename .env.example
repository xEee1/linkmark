# linkmark · 环境变量样例（运维交付，遵循 ARCHITECTURE.md §7）
# 用法：cp .env.example .env 后按需修改，再执行 docker compose up --build
# Compose 会自动读取项目根目录的 .env，对 docker-compose.yml 中的 ${...} 插值。

# ---- 数据库（db 服务 · postgres:16-alpine）----
POSTGRES_USER=linkmark
POSTGRES_PASSWORD=linkmark_dev_password
POSTGRES_DB=linkmark

# ---- 后端（backend 服务 · :3000，仅内网）----
# JWT 签名密钥：生产环境务必替换为随机长字符串
JWT_SECRET=please-change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Web 反代（web 服务 · 仅此端口对宿主机暴露）----
WEB_PORT=8080
